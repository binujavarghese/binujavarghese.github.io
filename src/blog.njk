---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
<section class="wrap block">
  <header class="list-header">
    <h1>All posts</h1>
    <p class="muted">Everything I've written, newest first.</p>
    <div class="topic-pills">
      {% for t in site.topics %}<a class="topic-pill" data-topic="{{ t.name | slugify2 }}" href="/topics/{{ t.name | slugify2 }}/">{{ t.name }}</a>{% endfor %}
    </div>
  </header>
  <div class="grid">
    {% for post in collections.posts %}{% include "partials/post-card.njk" %}{% endfor %}
  </div>
</section>
{% include "partials/subscribe.njk" %}
