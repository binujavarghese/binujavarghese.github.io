---
layout: layouts/base.njk
---
<section class="hero hero-blend">
  <div class="hero-bg" style="background-image: url('{{ site.heroPhoto or site.photo }}');" role="img" aria-label="Photo of {{ site.name }}"></div>
  <div class="wrap">
    <div class="hero-text">
      <p class="eyebrow">{{ site.eyebrow }}</p>
      <h1>{% if site.headlineHighlight and (site.headlineHighlight in site.headline) %}{{ site.headline | replace(site.headlineHighlight, '<span class="hl">' + site.headlineHighlight + '</span>') | safe }}{% else %}{{ site.headline }}{% endif %}</h1>
      <p class="hero-intro">{{ site.intro }}</p>
      <div class="hero-actions">
        <a class="btn" href="/newsletter/">Join my newsletter</a>
        <a class="link-arrow" href="/topics/">Explore articles →</a>
      </div>
    </div>
  </div>
</section>

<section class="quote-band">
  {% set allQuotes = site.quotes if (site.quotes and site.quotes.length) else [site.quote] %}
  <div class="wrap-narrow quote-rotator">
    {% for q in allQuotes %}
    <figure class="quote-item{% if loop.first %} is-active{% endif %}">
      <blockquote>“{{ q.text }}”</blockquote>
      <figcaption>{{ q.author }}{% if q.topic %} · <a href="/topics/{{ q.topic | slugify2 }}/">{{ q.topic }}</a>{% endif %}</figcaption>
    </figure>
    {% endfor %}
  </div>
  {% if allQuotes.length > 1 %}
  <script>
    (function () {
      var items = document.querySelectorAll('.quote-item');
      var i = 0;
      setInterval(function () {
        items[i].classList.remove('is-active');
        i = (i + 1) % items.length;
        items[i].classList.add('is-active');
      }, 6000);
    })();
  </script>
  {% endif %}
</section>

{% if collections.posts.length %}
<section class="wrap block">
  <div class="section-head">
    <h2 class="section-title">Start with these</h2>
    <a class="link-arrow" href="/topics/">Explore articles →</a>
  </div>
  <div class="grid">
    {% for post in collections.posts | featured | limit(3) %}{% include "partials/post-card.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

<section class="topics-strip">
  <div class="wrap">
    <h2 class="section-title">Explore by topic</h2>
    <div class="topic-pills">
      {% for t in site.topics %}
        <a class="topic-pill" data-topic="{{ t.name | slugify2 }}" href="/topics/{{ t.name | slugify2 }}/">{% set name = t.name %}{% include "partials/topic-icon.njk" %}<span>{{ (t.name | trim).split(" ").slice(1).join(" ") }}</span></a>
      {% endfor %}
    </div>
  </div>
</section>

{% for t in site.topics %}
  {% set tposts = collections.posts | byTopic(t.name) %}
  {% if tposts.length %}
  <section class="wrap block">
    <div class="section-head">
      <div>
        <h2 class="section-title">{{ t.name }}</h2>
        <p class="muted">{{ t.description }}</p>
      </div>
      <a class="link-arrow" href="/topics/{{ t.name | slugify2 }}/">See all →</a>
    </div>
    <div class="grid">
      {% for post in tposts | limit(3) %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </section>
  {% endif %}
{% endfor %}

<section class="wrap block about-strip">
  <img src="{{ site.photo }}" alt="" class="avatar-xl">
  <div>
    <p class="eyebrow">About me</p>
    <h2 class="section-title">I'm {{ site.firstName }}, a chemist who believes science belongs to everyone.</h2>
    <p>From Kottayam, Kerala, to a PhD at the University of Limerick, I've learned that research is as much about curiosity, patience and small wins as it is about results. This blog is where I share both: the science, and the story behind it.</p>
    <a class="link-arrow" href="/about/">Read my story →</a>
  </div>
</section>

{% include "partials/subscribe.njk" %}
